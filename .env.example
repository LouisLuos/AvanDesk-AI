# ==============================================================================
# Nexo (AvanDesk-AI) — Variáveis de Ambiente de Exemplo
# ==============================================================================

# ===== Perfil de Execução =====
# Opções: dev (Docker local com H2/Postgres local) | prod (Supabase + Render)
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# ===== Banco de Dados (Produção - Supabase / Render) =====
# No Render, DATABASE_URL recebe a connection string JDBC do Supabase (porta 5432 / pooler)
DATABASE_URL=jdbc:postgresql://host.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.seu_projeto
DATABASE_PASSWORD=sua_senha_forte

# ===== Banco de Dados (Desenvolvimento Local Docker) =====
POSTGRES_DB=avandesk_db
POSTGRES_USER=avandesk
POSTGRES_PASSWORD=avandesk_dev

# ===== Segurança & Autenticação JWT (HU09) =====
# Chave HMAC-SHA256 segura (mínimo 256 bits / 32 caracteres)
JWT_SECRET=coloque_uma_chave_secreta_muito_segura_aqui_com_no_minimo_32_caracteres
JWT_EXPIRATION_MS=3600000

# ===== Frontend (Vercel) =====
# URL da API REST consumida pelo Angular
API_BASE_URL=https://nexodesk-api-ru6l.onrender.com/api/v1
